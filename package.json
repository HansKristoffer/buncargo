{
  "name": "buncargo",
  "version": "15.1.0",
  "description": "Bun-first dev environments for many checkouts at once: isolated ports, containers, databases and https://*.localhost hosts per worktree, with supervised dev servers",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HansKristoffer/buncargo.git"
  },
  "author": "Kristoffer Hansen",
  "keywords": [
    "bun",
    "dev-tools",
    "docker",
    "docker-compose",
    "development",
    "cli",
    "monorepo",
    "dev-server",
    "environment"
  ],
  "engines": {
    "bun": ">=1.4.4"
  },
  "files": [
    "dist",
    "readme.md",
    "CHANGELOG.md",
    "docs/reference.md",
    "docs/integrations.md",
    "docs/migration.md",
    "docs/frp.md",
    "docs/runtime-maintenance.md"
  ],
  "bin": {
    "buncargo": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js",
      "default": "./dist/api/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "react-native": "./dist/client/index.js",
      "browser": "./dist/client/index.js",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js",
      "default": "./dist/runtime/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    },
    "./next": {
      "types": "./dist/next/index.d.ts",
      "import": "./dist/next/index.js",
      "default": "./dist/next/index.js"
    },
    "./expo": {
      "types": "./dist/expo/index.d.ts",
      "import": "./dist/expo/index.js",
      "default": "./dist/expo/index.js"
    },
    "./shopify": {
      "types": "./dist/shopify/index.d.ts",
      "import": "./dist/shopify/index.js",
      "default": "./dist/shopify/index.js"
    },
    "./supabase": {
      "types": "./dist/supabase/index.d.ts",
      "import": "./dist/supabase/index.js",
      "default": "./dist/supabase/index.js"
    },
    "./firebase": {
      "types": "./dist/firebase/index.d.ts",
      "import": "./dist/firebase/index.js",
      "default": "./dist/firebase/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && bun run build:js && bun run build:daemon && bun scripts/fix-sourcemap-sources.ts dist && bun run build:types",
    "build:daemon": "bun build ./src/cli/hostsd.ts --outdir ./dist --target bun --sourcemap=linked && bun build ./src/cli/connectd.ts --outdir ./dist --target bun --sourcemap=linked",
    "build:js": "bun build ./src/index.ts ./src/api/index.ts ./src/cli/bin.ts ./src/core/watchdog-runner.ts ./src/vite/index.ts ./src/next/index.ts ./src/expo/index.ts ./src/shopify/index.ts ./src/supabase/index.ts ./src/firebase/index.ts ./src/client/index.ts ./src/runtime/index.ts --outdir ./dist --root ./src --target node --packages external --splitting --sourcemap=linked",
    "build:types": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "fmt": "bun fmt --no-script '{src,scripts,example,server/connect}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}'",
    "lint": "bun run typecheck && knip && biome check src scripts example server/connect && bun fmt --no-script --check '{src,scripts,example,server/connect}/**/*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}'",
    "lint:write": "bun run typecheck && knip && biome check --fix src scripts example server/connect && bun run fmt",
    "typecheck": "bun check && tsc --noEmit -p tsconfig.json",
    "test": "bun test --parallel",
    "test:integration-cloudflared": "BUNCARGO_TEST_CLOUDFLARED_SMOKE=1 bun test src/core/quick-tunnel/quick-tunnel.test.ts",
    "test:integration-cloudflared-e2e": "BUNCARGO_TEST_CLOUDFLARED_SMOKE=1 BUNCARGO_TEST_CLOUDFLARED_E2E=1 bun test src/core/quick-tunnel/quick-tunnel.test.ts",
    "test:integration-hosts": "BUNCARGO_TEST_HOSTS=1 bun test src/core/hosts/hosts.integration.test.ts",
    "test:integration-proxy-idle": "BUNCARGO_TEST_PROXY_IDLE=1 bun test src/core/hosts/proxy-idle.integration.test.ts",
    "test:integration-hosts-soak": "BUNCARGO_TEST_HOSTS_SOAK=1 bun test src/core/hosts/worktree-soak.test.ts",
    "test:integration-apple": "BUNCARGO_TEST_APPLE_CONTAINER=1 bun test src/apple-container/apple-container.integration.test.ts",
    "verify:package": "bun scripts/verify-package.ts",
    "ci:local": "bun scripts/ci-local.ts",
    "test:integration-frp": "BUNCARGO_TEST_FRP=1 bun test src/core/connect/frp.integration.test.ts",
    "test:integration-shopify-cli": "BUNCARGO_TEST_SHOPIFY_CLI=1 bun test src/shopify/cli-contract.test.ts",
    "benchmark:startup": "bun scripts/benchmark-startup-matrix.ts",
    "test:stress-sessions": "bun scripts/stress-library-sessions.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.4",
    "@types/bun": "1.4.2",
    "knip": "^6.45.1",
    "typescript": "^5.7.0",
    "vite": "8.1.5"
  },
  "dependencies": {
    "@xterm/headless": "^6.0.0",
    "hanzio": "^3.4.0",
    "picocolors": "^1.1.1"
  },
  "homepage": "https://github.com/HansKristoffer/buncargo#readme",
  "bugs": {
    "url": "https://github.com/HansKristoffer/buncargo/issues"
  },
  "packageManager": "bun@1.4.4"
}
