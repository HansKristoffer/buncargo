exports[`buncargo CLI output sql --help 1`] = `
"exit 0
--- stdout

Usage: buncargo sql [<service>] [options] [-- <args>]

Open the database's own client in this checkout's container

Arguments:
  <service>  The database service (default: the config's first database)

Options:
  --command=<query>, -c    Run one query and exit; without it, an interactive shell
  --create-scratch=<name>  (Re)create an empty Postgres database scratch_<name> and print its URL
  --drop-scratch=<name>    Drop the database scratch_<name>
  --json                   With --command, print the rows as JSON (Postgres, ClickHouse)
  --db=<database>          Use another database of this checkout's Postgres, as it is (e.g. scratch_<name>)
  --url                    Print the Postgres database's URL instead of connecting
  --help, -h               Show this help message
  --                       Passed to the client (psql -tA, -v ON_ERROR_STOP=0, -f <host file>)
  stdin                    Without -c, SQL piped or in a heredoc runs as a script; it stops at the first error

Exit codes:
  0  success
  1  bad arguments, or nothing to connect to; otherwise the client's own code

Examples:
  buncargo sql                                                     psql into this checkout's database
  buncargo sql -c "select count(*) from users" --json              One query, rows as JSON
  buncargo sql redis -c 'GET key'                                  redis-cli
  DATABASE_URL=$(buncargo sql --create-scratch=migcheck) bun test  A throwaway database in this checkout's Postgres
  buncargo sql --db=scratch_migcheck -- -tA -f query.sql           A file against an existing database, psql flags after --
  buncargo sql <<'SQL' ... SQL                                     A script from a heredoc


--- stderr
"
`;

exports[`buncargo CLI output prune --help 1`] = `
"exit 0
--- stdout

Usage: buncargo prune [options]

Remove volumes whose project is gone (destroys their data)

Options:
  --dry-run           List what would be removed and stop
  --yes               Skip the confirmation (for scripts)
  --older-than=<age>  Only volumes of checkouts deleted at least this long ago, e.g. 7d, 12h, 30m
  --project           Only this project's leftovers: every checkout's ci stack and every stack of a deleted worktree (containers, volumes, networks)
  --help, -h          Show this help message
                      Removes the volumes of checkouts whose directory was deleted, when no container, run or other checkout uses their project. Destroys their data.

Exit codes:
  0  removed, listed (--dry-run), declined, or nothing to remove
  1  a removal failed, offsets.json is unreadable, or bad arguments

Examples:
  bunx buncargo prune --dry-run                  List reclaimable volumes without touching them
  bunx buncargo prune                            Review the list, then confirm removal
  bunx buncargo prune --older-than=7d --dry-run  Only checkouts deleted a week ago or longer
  bunx buncargo prune --project --dry-run        List this project's leftover ci and deleted-worktree stacks


--- stderr
"
`;

