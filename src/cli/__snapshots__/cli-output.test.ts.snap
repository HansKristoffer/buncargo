// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`buncargo CLI output setup --help 1`] = `
"exit 0
--- stdout

Usage: buncargo setup [options]

Run the fix of every failing check

Options:
  --yes       Run every fix without asking (implied in CI)
  --agents    Add or update the buncargo block in AGENTS.md (pointing at \`help agents\`), then exit
  --help, -h  Show this help message

Exit codes:
  0  success
  1  a check still fails, or bad arguments

Examples:
  bunx buncargo setup  Check the checkout and offer each fix


--- stderr
"
`;

exports[`buncargo CLI output run --help 1`] = `
"exit 0
--- stdout

Usage: buncargo run [<task>] [-- <args>]

Run a task from dev.config.ts (lists them without a name)

Arguments:
  <task>  A key of tasks in dev.config.ts

Options:
  --help, -h  Show this help message
  --          Arguments appended to the task's command

Exit codes:
  0  success
  1  bad arguments or task; otherwise the task's own code

Examples:
  buncargo run            List the configured tasks
  buncargo run shop:seed  Run one task


--- stderr
"
`;

exports[`buncargo CLI output wait --help 1`] = `
"exit 0
--- stdout

Usage: buncargo wait --app=<name> [options]

Block until an app of this checkout's run is healthy

Options:
  --app=<name>         The app to wait for (required)
  --timeout=<seconds>  Give up after this long; 0 waits forever (default: 120)
  --hold               Once healthy, stay alive until the run stops
  --help, -h           Show this help message

Exit codes:
  0    healthy (and, with --hold, a signal after that)
  1    the app failed or stopped, or bad arguments
  2    timed out waiting
  130  interrupted before the app was healthy (Ctrl-C); 143 for SIGTERM

Examples:
  buncargo wait --app=api && bunx playwright test  Test once this checkout's API is up


--- stderr
"
`;

exports[`buncargo CLI output generate --help 1`] = `
"exit 0
--- stdout

Usage: buncargo generate

Render generatedFiles without starting anything

Options:
  --help, -h  Show this help message

Exit codes:
  0  success
  1  failed, or bad arguments

Examples:
  BASE_URL=https://… bunx buncargo generate  Render generatedFiles in CI, from the environment


--- stderr
"
`;

exports[`buncargo CLI output build --help 1`] = `
