"exit 0
--- stdout

Usage: buncargo bar <command>

The BuncargoBar menu bar app

Commands:
  install    Download and install the menu bar app
  update     Update the app to the latest release
  status     Installed version, and whether it is running
  open       Open the app, installing it first if needed
  uninstall  Quit and remove the app
  reset      Offer the app again after declining it

Without a command: Installed version, and whether it is running

Options:
  --help, -h  Show this help message

Exit codes:
  0  success
  1  failed, or bad arguments

Run "bunx buncargo bar <command> --help" for a command's options.


--- stderr
"
`;

exports[`buncargo CLI output buncargo typecheck --nope 1`] = `
"exit 1
--- stdout

--- stderr
  ❌ Unknown flag: --nope
   Run "bunx buncargo typecheck --help" for options.
"
`;

exports[`buncargo CLI output buncargo stop --nope 1`] = `
"exit 1
--- stdout

--- stderr
  ❌ Unknown flag: --nope
   Run "bunx buncargo stop --help" for options.
"
`;

exports[`buncargo CLI output buncargo stop nope 1`] = `
"exit 2
--- stdout

--- stderr
  ❌ No active buncargo run for <cwd>.
   Run \`buncargo runs\` to see what is active.
"
`;

exports[`buncargo CLI output buncargo stop 1`] = `
"exit 0
--- stdout
  Nothing running for this checkout (<cwd>).

--- stderr
"
`;

exports[`buncargo CLI output buncargo down --help 1`] = `
"exit 0
--- stdout

Usage: buncargo stop [<name>...] [options]

Stop one app or service, or a whole run

Arguments:
  <name>  App or service from \`buncargo runs\`

Options:
  --root=<path>    Checkout whose run to act on (default: this one)
  --run=<session>  One run session from buncargo runs (default: matching checkout sessions)
  --all            Stop the whole run: dev servers and containers, and an ended run's idle containers
  --force          Skip the confirmation for a risky target
  --help, -h       Show this help message

Exit codes:
  0  stopped, or nothing was running
  1  could not stop it (a teardown failed, the runtime did not answer), or bad arguments
  2  a named app or service matched nothing
  3  refused: left running (needs a confirmation or --force, or its process could not be identified)

Examples:
  bunx buncargo stop           Same as --all: stop this checkout's run (one in another terminal asks first)
  bunx buncargo stop api       Stop one dev server
  bunx buncargo stop postgres  Stop one service's container
  bunx buncargo stop --all     Stop this checkout's whole run


--- stderr
   \`buncargo down\` is \`buncargo stop\`; use \`buncargo stop\`.
"
`;

exports[`buncargo CLI output buncargo wait 1`] = `
"exit 1
--- stdout

--- stderr
  ❌ --app is required
   Run "bunx buncargo wait --help" for options.
"
`;

