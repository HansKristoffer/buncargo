exports[`buncargo CLI output stop --help 1`] = `
"exit 0
--- stdout

Usage: buncargo stop [<name>...] [options]

Stop one app or service, or a whole run

Arguments:
  <name>  App or service from \`buncargo runs\`

Options:
  --root=<path>    Checkout whose run to act on (default: this one)
  --run=<session>  One run session from buncargo runs (default: matching checkout sessions)
  --all            Stop the whole run: dev servers and containers, and an ended run's idle containers
  --force          Skip the confirmation for a risky target
  --help, -h       Show this help message

Exit codes:
  0  stopped, or nothing was running
  1  could not stop it (a teardown failed, the runtime did not answer), or bad arguments
  2  a named app or service matched nothing
  3  refused: left running (needs a confirmation or --force, or its process could not be identified)

Examples:
  bunx buncargo stop           Same as --all: stop this checkout's run (one in another terminal asks first)
  bunx buncargo stop api       Stop one dev server
  bunx buncargo stop postgres  Stop one service's container
  bunx buncargo stop --all     Stop this checkout's whole run


--- stderr
"
`;

exports[`buncargo CLI output restart --help 1`] = `
"exit 0
--- stdout

Usage: buncargo restart <app>... [options]

Restart one app of a running dev (e.g. a stopped non-essential one)

Arguments:
  <app>  An app of the run

Options:
  --root=<path>    Checkout whose run to act on (default: this one)
  --run=<session>  One run session from buncargo runs
  --help, -h       Show this help message

Exit codes:
  0  the app's process was replaced
  1  the replacement failed, the run did not answer, or bad arguments
  2  no run of this checkout started the app
  3  refused: the run takes no requests (a script's start()) or the app is not its own

Examples:
  bunx buncargo restart shopify  Start a stopped app of this checkout's run again


--- stderr
"
`;

exports[`buncargo CLI output send --help 1`] = `
"exit 0
--- stdout

Usage: buncargo send <app> [<keys>...] [options]

Type into an app that has a terminal (e.g. Expo's i)

Arguments:
  <app>   An app of the run
  <keys>  The text to type, words joined by spaces

Options:
  --enter          Press Enter after the text
  --root=<path>    Checkout whose run to act on (default: this one)
  --run=<session>  One run session from buncargo runs
  --help, -h       Show this help message

Exit codes:
  0  typed
  1  the run did not answer, or bad arguments
  2  no run of this checkout started the app
  3  the app cannot take keys (no terminal of its own, or not running)

Examples:
  bunx buncargo send expoApp i       Press i in Expo: open the iOS simulator
  bunx buncargo send api rs --enter  Type a line into an app's prompt


--- stderr
"
`;

exports[`buncargo CLI output logs --help 1`] = `
"exit 0
--- stdout

Usage: buncargo logs [<app>] [options]

Read app output from the current or last run

Arguments:
  <app>  One app's output (default: every app)

Options:
  --follow, -f       Keep printing new lines until the run ends
  --since=<5m>       Only lines newer than this (s, m, h)
  --errors           Only lines that read as errors
  --root=<path>      Checkout whose logs to read (default: this one)
  --run=<sessionId>  The run whose logs to read (default: the live run of <app>, else the newest)
  --help, -h         Show this help message

Exit codes:
  0  success
  1  failed, or bad arguments

Examples:
  buncargo logs                    Every app, interleaved
  buncargo logs shopify --errors   What went wrong in one app
  buncargo logs api -f --since=5m  Tail one app
  buncargo logs --run=<sessionId>  One run's apps, by the id \`buncargo runs\` prints


--- stderr
"
`;

