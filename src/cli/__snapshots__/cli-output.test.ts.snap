// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`buncargo CLI output setup --help 1`] = `
"exit 0
--- stdout

Usage: buncargo setup [--yes] [--agents]

Options:
  --help    Show this help message
  --yes     Run every fix without asking (implied in CI)
  --agents  Add or update the buncargo block in AGENTS.md (pointing at \`help agents\`), then exit

Examples:
  bunx buncargo setup  Check the checkout and offer each fix


--- stderr
"
`;

exports[`buncargo CLI output run --help 1`] = `
"exit 0
--- stdout

Usage: buncargo run [<task>] [-- args...]

Options:
  --help  Show this help message
  <task>  A key of tasks in dev.config.ts
  --      Following arguments go to the command

Examples:
  buncargo run            List the configured tasks
  buncargo run shop:seed  Run one task


--- stderr
"
`;

exports[`buncargo CLI output wait --help 1`] = `
"exit 0
--- stdout

Usage: buncargo wait --app=<name> [--timeout=<seconds>] [--hold]

Options:
  --help               Show this help message
  --app=<name>         The app to wait for (required)
  --timeout=<seconds>  Give up after this long; 0 waits forever (default: 120)
  --hold               Once healthy, stay alive until the run stops

Examples:
  buncargo wait --app=api && bunx playwright test  Test once this checkout's API is up


--- stderr
"
`;

