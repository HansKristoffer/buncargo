exports[`buncargo CLI output exec --help 1`] = `
"exit 0
--- stdout

Usage: buncargo exec [--app=<name>] [--cwd=<path>] [--slot] -- <command> [args...]

Options:
  --help        Show this help message
  --app=<name>  Use this app's environment and default working directory
  --cwd=<path>  Working directory relative to the repository root
  --slot        Hold one of the machine-wide check slots (BUNCARGO_CHECK_SLOTS, default 3) while it runs
  --            Required separator; following arguments are passed unchanged


--- stderr
"
`;

exports[`buncargo CLI output slot --help 1`] = `
"exit 0
--- stdout

Usage: buncargo slot -- <command> [args...]

Options:
  --help  Show this help message
  --      Required separator; following arguments are passed unchanged

Examples:
  bunx buncargo slot -- bun test  Run a test suite once a slot is free, with the shell's own environment


--- stderr
"
`;

exports[`buncargo CLI output connect --help 1`] = `
"exit 0
--- stdout

Usage: buncargo connect <token|status|open|tcp|disconnect|revoke> [target-id] [--json]

Options:
  --help                   Show connection help
  --json                   Print JSON
  --rotate                 Replace the publish-only recipient token
  BUNCARGO_CONNECT_TOKENS  Comma-separated recipient tokens: dev automatically shares selected endpoints.
  BUNCARGO_CONNECT_NAME    Optional remote environment group name in BuncargoBar.


--- stderr
"
`;

exports[`buncargo CLI output dev --help 1`] = `
"exit 0
--- stdout

Usage: buncargo dev [options]

Options:
  --help                         Show this help message
  --down                         Stop all containers
  --all                          With --down, stop every buncargo environment you started on this machine
  --reset                        Stop containers and remove volumes (fresh start)
  --yes                          Confirm --reset or --down --all without a prompt (required without a terminal)
  --migrate                      Run migrations and exit
  --seed                         Run migrations and seeders, then exit
  --up-only                      Start containers only, then exit (no migrations, seed, or dev servers)
  --expose[=<targets>]           Expose configured targets via public quick tunnels
  --apps=<apps>                  Run selected apps plus their requiredApps
  --profile=<name>               Run a profile's apps (default: the profile named default)
  --attach=<app>                 Give one app the TTY (overrides interactive: true)
  --no-watch                     Do not restart apps when their watched files change
  --detach                       Run in the background; return once the apps are up (logs: buncargo logs)
  --tui                          Terminal UI, the default in a terminal; warns when there is none
  --no-tui                       Prefixed lines instead of the terminal UI, even in a terminal
  --keep-containers              Keep the containers after the run exits, as long as the checkout exists
  --takeover                     Stop apps already running elsewhere and run them here
  --watchdog-timeout=N           Idle backstop in minutes (default: 3)
  --no-docker-autostart          Do not try to start Docker if it is down
  --no-hosts                     Use localhost:port instead of named .localhost URLs
  --runtime=<docker|apple|auto>  Container runtime backend (default: docker)
  --timing-json                  Report startup through app readiness as JSON
  --timing                       Print how long each startup phase took
  --                             Extra args appended to the attached app command

Examples:
  bun dev                            Start selected apps and their services
  bun dev --seed                     Run migrations and seed the database
  bun dev --down                     Stop all containers
  bun dev --reset                    Stop containers and remove all data
  bun dev --apps=api,platform        Run only selected apps
  bun dev --profile=full             Run the apps of profiles.full
  bun dev --expose                   Expose all targets with expose: true
  bun dev --expose=api,web           Expose specific targets
  bun dev --apps=expoApp -- --clear  Pass args to the attached app
  bun dev --runtime=apple            Run services on Apple container instead of Docker
  bun dev --no-tui                   Prefixed lines instead of the terminal UI
  bun dev --takeover                 Move apps running in another terminal into this one


--- stderr
"
`;

exports[`buncargo CLI output typecheck --help 1`] = `
"exit 0
--- stdout

Usage: buncargo typecheck [options]

Options:
  --help               Show this help message
  --concurrency=N      Max typecheck processes (default: CPUs, cap 4 local / 2 in CI)
  --only=<workspaces>  Check only these workspaces (path or basename, comma-separated)
  --group=<name>       Check one of the config's typecheck.groups (CI runners)
  --changed[=<ref>]    Check only workspaces changed since the merge base with <ref> (default: origin's default branch), and their dependents

Examples:
  bunx buncargo typecheck                  Check every workspace plus the root config
  bunx buncargo typecheck --only=platform  Check one workspace (path or basename)
  bunx buncargo typecheck --changed        Check what this branch can break, uncommitted work included
  bunx buncargo typecheck --group=web      Check one typecheck.groups selection, e.g. one CI job
  bunx buncargo typecheck --concurrency=2  Cap overlapping typecheck processes


--- stderr
"
`;

exports[`buncargo CLI output check --help 1`] = `
"exit 0
--- stdout

Usage: buncargo check [docs] [--staged | --all] [--base=<ref>]

Options:
  --help        Show this help message
  --staged      Staged files only: no writes, no tests (pre-commit)
  --all         Every file, workspace and gate; no tests (lint)
  --base=<ref>  Compare with the merge base of <ref> (default: origin's default branch)
  docs          Only check Markdown links and documented commands, in every doc

Examples:
  buncargo check           Biome, typecheck, gates and nearby tests for this branch's changes
  buncargo check --staged  The pre-commit hook: staged files, no writes
  buncargo check --all     Every check but the tests, e.g. as \`bun run lint\`


--- stderr
"
`;

exports[`buncargo CLI output predeploy --help 1`] = `
"exit 0
--- stdout

Usage: buncargo predeploy

Options:
  --help  Show this help message

Examples:
  bunx buncargo predeploy  Migrate, then seed unless production (e.g. Railway's preDeployCommand)


--- stderr
"
`;

exports[`buncargo CLI output files --help 1`] = `
"exit 0
--- stdout

Usage: buncargo files <command> [path...]

Options:
  --help                      Show this help message
  --json                      status: machine-readable output
  --force                     pull: replace local edits, backed up to .buncargo/files-backup/
  --checkout=<KEY,...>        merge: keep this checkout's value of these conflicting keys
  --store=<KEY,...>           merge: take the file store's value of these conflicting keys
  --include-machine           export: include machine: true files
  status [--json]             Each file's state
  save [path...]              Checkout → file store, so other checkouts get it
  pull [path...] [--force]    File store → checkout; never over local edits without --force
  merge <path>                Merge a dotenv file's local edits and the store's changes key by key
  diff [path]                 Keys added, removed and changed, never values
  export [--include-machine]  The file store as a bundle on stdout
  import [-|file]             Write a bundle into the file store

Examples:
  buncargo files export | ssh box 'cd app && bunx buncargo files import'  Copy them to another machine


--- stderr
"
`;

exports[`buncargo CLI output secrets --help 1`] = `
"exit 0
--- stdout

Usage: buncargo secrets ls [--app=<name>] [--env=<slug>]

Options:
  --help        Show this help message
  --app=<name>  This app's scope instead of the config-level one
  --env=<slug>  This Infisical environment
  ls            Key names and where each comes from, never values


--- stderr
"
`;

exports[`buncargo CLI output ci --help 1`] = `
"exit 0
--- stdout

Usage: buncargo ci [options] [-- <command> [args...]]

Options:
  --help                         Show this help message
  --migrate                      Run migrations (and Prisma generate) after services start
  --seed                         Run migrations, then the seed command
  --services=<names>             Start only these services (default: every configured one)
  --runtime=<docker|apple|auto>  Container runtime backend (default: docker)
  --                             Command to run with the checkout environment

Examples:
  buncargo ci --migrate -- bun test  Services up, migrations applied, tests, teardown
  buncargo ci --seed                 Check that migrations and the seed apply cleanly


--- stderr
"
`;

