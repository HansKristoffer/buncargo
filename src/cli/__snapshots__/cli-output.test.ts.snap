exports[`buncargo CLI output stop --help 1`] = `
"exit 0
--- stdout

Usage: buncargo stop [<name>...] [options]

Options:
  --help           Show this help message
  --root=<path>    Checkout whose run to act on (default: this one)
  --run=<session>  One run session from buncargo runs (default: matching checkout sessions)
  --all            Stop the whole run: dev servers and containers, and an ended run's idle containers
  --force          Skip the confirmation for a risky target
  <name>           App or service from \`buncargo runs\` (repeatable)

Examples:
  bunx buncargo stop api       Stop one dev server
  bunx buncargo stop postgres  Stop one service's container
  bunx buncargo stop --all     Stop this checkout's whole run


--- stderr
"
`;

