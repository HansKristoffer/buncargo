exports[`buncargo CLI output prisma --help 1`] = `
"exit 0
--- stdout

Usage: buncargo prisma <args>

Run Prisma CLI with correct DATABASE_URL

Options:
  --yes                 Run a destructive action (migrate reset, db push --force-reset) without a terminal
  --db=<name>           Point Prisma at another database of this checkout's Postgres, e.g. scratch_<name>
  --help, -h            Show this help message
  <args>                Prisma's own arguments, unchanged
  migration new <name>  Write a migration from schema.prisma, after the newest one, and print its path
  migration check       Fail when a migration's timestamp collides or sorts before the base branch's newest
  migrate-check         Fail when migrations and schema.prisma differ

Exit codes:
  0  success
  1  Prisma failed, a check failed, or bad arguments; Prisma's own code otherwise
  4  the database applied migrations this branch lacks (a squashed chain)

Examples:
  bunx buncargo prisma studio                   Open Prisma Studio
  bunx buncargo prisma migration new add_users  Write a migration without a terminal


--- stderr
"
`;

exports[`buncargo CLI output buncargo 1`] = `
"exit 0
--- stdout

buncargo - Development environment CLI

USAGE:
  bunx buncargo <command> [options]

COMMANDS:
  setup [options]                           Run the fix of every failing check
  run [<task>] [-- <args>]                  Run a task from dev.config.ts (lists them without a name)
  wait --app=<name> [options]               Block until an app of this checkout's run is healthy
  generate                                  Render generatedFiles without starting anything
  build [<app>...] [options]                Run apps' buildCommand one at a time
  exec [options] -- <command> [args...]     Run a command with the checkout environment
  slot -- <command> [args...]               Run a heavy command in a machine-wide check slot, environment untouched
  connect <command>                         Discover private services through frp (token | status | open | tcp | disconnect | revoke)
  dev [<app>...] [options] [-- <args>]      Start the development environment
  typecheck [options]                       Run TypeScript typecheck across workspaces
  check [docs] [options]                    Biome, typecheck, gates and nearby tests for the change in front of you (docs)
  predeploy                                 Before a deploy: migrate, then seed unless production
  prisma <args>                             Run Prisma CLI with correct DATABASE_URL
  files <command>                           Gitignored files every checkout needs (.env.local), per machine (status | save | pull | merge | diff | export | import)
  secrets <command>                         List Infisical keys and where each comes from (never values) (ls | check)
  ci [options] [-- <args>]                  Start services in CI, prepare them, run a command, tear down
  env [options] | env set|unset             Print environment info as JSON, or override a variable (set | unset)
  url [<name>] [options]                    Print an app's or a captured URL (lists them without a name)
  open [<name>] [<capture>]                 Open the primary app, or any URL \`url\` lists
  ls                                        List every buncargo environment on this machine
  runs [options]                            Show the dev runs active on this machine
  stop [<name>...] [options]                Stop one app or service, or a whole run
  restart <app>... [options]                Restart one app of a running dev (e.g. a stopped non-essential one)
  send <app> [<keys>...] [options]          Type into an app that has a terminal (e.g. Expo's i)
  logs [<app>] [options]                    Read app output from the current or last run
  ports [pin <offset> | release [options]]  Show this checkout's ports and every claim; pin one, or release a stale one (pin | release)
  sql [<service>] [options] [-- <args>]     Open the database's own client in this checkout's container
  status [options]                          Show this project's containers, ports, and tunnels
  prune [options]                           Remove volumes whose project is gone (destroys their data)
  doctor [options]                          Check Docker, port owners, lockfile, hosts, and orphans
  hosts <command>                           Named .localhost URLs (install | status | sync | prune | uninstall | daemon)
  bar <command>                             The BuncargoBar menu bar app (install | update | status | open | uninstall | reset)
  help [agents] [<topic>]                   Show this help message, or the guide for AI agents
  version                                   Show version

EXAMPLES:
  bunx buncargo dev                     # Start everything
  bunx buncargo dev api                 # Start only api, plus its requiredApps
  bunx buncargo dev --detach            # Start in the background, return once up
  bunx buncargo dev --expose            # Public quick tunnel for expose:true targets
  bunx buncargo dev --down              # Stop containers
  bunx buncargo status --json           # This checkout's runs, ports and containers
  bunx buncargo doctor                  # Diagnose common local-dev problems
  bunx buncargo env --get DATABASE_URL  # One raw value for scripts
  bunx buncargo run db:seed             # Run a task from dev.config.ts
  bunx buncargo ci --migrate -- bun test # Services + migrations in CI
  bunx buncargo help agents             # The guide for AI agents

CONFIG:
  Create a dev.config.ts with a default export:

  import { defineDevConfig } from 'buncargo'

  export default defineDevConfig({
    projectPrefix: 'myapp',
    services: { ... },
    apps: { ... }
  })

Run "bunx buncargo <command> --help" for a command's options and exit codes.


--- stderr
"
`;

